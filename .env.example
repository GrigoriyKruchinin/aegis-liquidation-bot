# =============================================================================
# Aegis Liquidations — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- General -----------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# JSON log lines (true) or human-readable console output (false)
LOG_JSON=true

# --- Telegram (required) -----------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Your chat id (getUpdates -> message.chat.id); groups/channels start with -100
TELEGRAM_CHAT_ID=123456789

# --- RPC ---------------------------------------------------------------------
# One Alchemy key covers Base, Arbitrum and OP Mainnet (enable them in the Alchemy app).
ALCHEMY_API_KEY=replace-me
# Optional extra / fallback RPC URLs per chain, comma-separated. Used before Alchemy.
BASE_RPC_URLS=
ARBITRUM_RPC_URLS=
OPTIMISM_RPC_URLS=
# eth_getLogs-only endpoints (indexers, competitor analysis), tried before the URLs above.
# Alchemy's free tier caps eth_getLogs at a 10-block range, so history is read from free public
# archive nodes. Leave unset for these defaults; set to an empty value to disable.
# BASE_LOG_RPC_URLS=https://base.gateway.tenderly.co
# ARBITRUM_LOG_RPC_URLS=https://arb1.arbitrum.io/rpc
# OPTIMISM_LOG_RPC_URLS=https://mainnet.optimism.io
# Budget per log-only endpoint, same units as RPC_CU_PER_SECOND (150 = two eth_getLogs/s).
RPC_LOG_CU_PER_SECOND=150
RPC_TIMEOUT_SECONDS=15
RPC_MAX_RETRIES=3
RPC_MAX_CONCURRENCY=8
MULTICALL_BATCH_SIZE=150
# Shared RPC throughput budget per provider key in compute units/second, across ALL chains and
# services (Alchemy limits CUPS per app, not per chain). Set to ~80% of your plan's CUPS
# (Alchemy dashboard -> app -> Throughput). 0 disables client-side limiting.
RPC_CU_PER_SECOND=300
# Share of that budget dedicated to the watcher (fast detection); indexers, scans and market
# enrichment get the rest. Two independent buckets: neither side can starve the other.
RPC_RESERVE_PCT=30

# --- Scanning ----------------------------------------------------------------
ENABLED_CHAINS=base,arbitrum,optimism
# Minimum net profit (USD, after gas) to send an alert
MIN_PROFIT_USD=5
# Positions with HF below this are re-checked by the watcher on every block
WATCHLIST_HF_THRESHOLD=1.05
# Ignore dust positions below this debt (USD)
MIN_DEBT_USD=10
INDEX_INTERVAL_SECONDS=60
SCAN_INTERVAL_SECONDS=30
# How far back the borrower indexer starts on first run
INDEXER_LOOKBACK_DAYS=30
# Initial eth_getLogs block range (auto-shrinks to what each endpoint accepts)
INDEXER_LOG_CHUNK_BLOCKS=10000
INDEXER_MAX_BLOCKS_PER_RUN=200000

# --- Notifications -----------------------------------------------------------
# Do not re-alert the same borrower/market within this window
ALERT_DEDUP_TTL_SECONDS=3600
SEND_STARTUP_MESSAGE=true
# Periodic "📊 Aegis status" report (tracked borrowers, debt, at-risk, indexer progress,
# opportunities/alerts in the period). 0 disables it.
STATUS_REPORT_INTERVAL_HOURS=1

# --- Fast watcher (detection latency) ---------------------------------------
# Every new block: one multicall reading all oracle prices of the chain + re-check of
# near-liquidation borrowers. Effective tick = max(block time, WATCHER_MIN_INTERVAL_MS):
# Base/Optimism ~2s (every block), Arbitrum 1s by default (250ms blocks; lower = more RPC usage).
WATCHER_MIN_INTERVAL_MS=1000
# Head polling while waiting for the next block (detection delay after a block is produced)
WATCHER_HEAD_POLL_MS=200
# Oracle price move (basis points, 50 = 0.5%) that triggers an immediate full market rescan
WATCHER_PRICE_MOVE_BPS=50
WATCHER_RESCAN_COOLDOWN_SECONDS=5

# --- Market measurement (competitor analysis before V2) ---------------------
# Index everyone's liquidations, measure how fast competitors are and whether we saw them first.
# Reports: `make market-report DAYS=14` -> data/market/
MARKET_ENABLED=true
MARKET_LOOKBACK_DAYS=30
MARKET_INDEX_INTERVAL_SECONDS=300
MARKET_ENRICH_INTERVAL_SECONDS=120
# Window searched (archive eth_call) for when a liquidated position became liquidatable
MARKET_LAG_WINDOW_MINUTES=120
# Dust liquidations below this gross profit skip the lag search (saves ~12 RPC calls each)
MARKET_LAG_MIN_GROSS_USD=1

# --- Free-tier / slow-connection profile (Alchemy free: 30M CU/month, 300 CU/s) ---
# A 24/7 per-block bot needs far more than the free monthly quota; on the free tier use e.g.:
#   RPC_CU_PER_SECOND=10        (≈ 30M CU / 30 days; 20 if the month is half over)
#   WATCHER_MIN_INTERVAL_MS=6000
#   SCAN_INTERVAL_SECONDS=120
#   INDEX_INTERVAL_SECONDS=120
#   RPC_TIMEOUT_SECONDS=30      (slow home internet)

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aegis
# `localhost` when running on the host; docker-compose overrides it to `postgres`
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------
# docker-compose overrides it to redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- V3 admin dashboard (not used in V1) -------------------------------------
# ADMIN_USERNAME=admin
# bcrypt hash, generate with `make hash-password` (V3)
# ADMIN_PASSWORD_HASH=
